# Copy this file to .env and adjust values as needed.
# .env is git-ignored — never commit real secrets.

# --- PostgreSQL ---
POSTGRES_USER=hirehub
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hirehub

# --- Backend ---
# Built from the POSTGRES_* values above; only override if using an external database.
DATABASE_URL=postgresql+psycopg2://hirehub:change_me@db:5432/hirehub
SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_ORIGIN=http://localhost:3000
SEED_DEMO_DATA=true

# --- Frontend ---
# Base URL the browser uses to reach the backend (baked in at build time).
VITE_API_URL=http://localhost:8000
