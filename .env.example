# Copy this file to .env and adjust values as needed.
# .env is git-ignored — never commit real secrets.

# --- PostgreSQL ---
POSTGRES_USER=hirehub
POSTGRES_PASSWORD=HireHub_DB_9vK7!mQ2#xR8
POSTGRES_DB=hirehub

# --- Backend ---
# Built from the POSTGRES_* values above; only override if using an external database.
DATABASE_URL=postgresql+psycopg2://hirehub:HireHub_DB_9vK7%21mQ2%23xR8@db:5432/hirehub
SECRET_KEY=9f7c2a4e8b1d6f3a5c0e7b9d2a4f8c1e6d3b7a9f5c2e8d1b4a6f0c3e7d9b2a5
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_ORIGIN=http://localhost:3000
SEED_DEMO_DATA=true
# Where uploaded resumes are stored inside the backend container — mounted to the
# resume_uploads Docker volume in docker-compose.yml, so files survive container restarts.
UPLOAD_DIR=/app/uploads

# --- Frontend ---
# Base URL the browser uses to reach the backend (baked in at build time).
VITE_API_URL=http://localhost:8000
